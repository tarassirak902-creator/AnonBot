[Unit]
Description=Anonymous Telegram Chat Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/anonymous-chat-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/anonymous-chat-bot/.venv/bin/python /opt/anonymous-chat-bot/run.py
Restart=always
RestartSec=5
TimeoutStopSec=30

# Базовые ограничения безопасности
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/anonymous-chat-bot/data /opt/anonymous-chat-bot/logs

[Install]
WantedBy=multi-user.target
